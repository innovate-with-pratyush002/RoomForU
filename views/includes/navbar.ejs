<nav class="navbar">
  <div class="nav-left">
    <a class="navbar-brand" href="/listings">
      <img
        class="navbar-logo"
        src="/CSS/image/blackLogo-removebg.png"
        alt="RoomForU logo"
      >
      RoomForU
    </a>
  </div>

  <div class="search-bar">
    <form action="/search" method="get">
      <input
        class="search-inp" 
        type="text"
        name="search"
        placeholder="Search by city, area, keywords..."
      >
      <button class="search-btn" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </form>
  </div>

  <!-- Hamburger -->
  <button class="menu-toggle" onclick="toggleMenu()">
   <i class="fa-solid fa-bars"></i>
  </button>

  <!-- Nav links -->
  <div class="nav-right" id="navMenu">
    <a class="nav-link" href="/">Home</a>
    <a class="nav-link" href="/listings">Listings</a>

    <% if (!currentUser) { %>
      <a class="nav-link" href="/signin">Sign In</a>
    <% } else { %>
      <a class="nav-link" href="/listings/new">Add New-Location</a>
      <a class="nav-link" href="/logout">Logout</a>

      <!--profile icon -->
      <a class="profile pbtn-div desktop-only" href="/profile" title="<%= currentUser.name || 'Profile' %>" style="display:flex;align-items:center;">
        <% if (currentUser.picture) { %>
          <img src="<%= currentUser.picture %>" alt="<%= currentUser.name %>" style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid rgb(6, 149, 162);">
        <% } else { %>
          <i class="fa-regular fa-circle-user"></i>
        <% } %>
      </a>

      <!--profile text -->
      <a class="nav-link mobile-only" href="/profile">Profile (<%= currentUser.name || 'User' %>)</a>
    <% } %>
  </div>
</nav>

<script>
  function toggleMenu() {
    document.getElementById("navMenu").classList.toggle("open");
  }
</script>
