<% layout('layouts/boilerplate') -%>

<link rel="stylesheet" href="/CSS/detail.css">
<link rel="stylesheet" href="/path/to/starability-growRotate.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<div class="detailPage">
  <section class="topSection">
    <div class="imageBox">
      <img src="<%= Data.image.url %>" alt="<%= Data.title %>" class="mainImage">
      <span class="statusBadge"><%= Data.availabilityStatus %></span>
    </div>

    <div class="infoSection">
      <p class="pageTag">Student stay details</p>
      <h1 class="mainTitle"><%= Data.title %></h1>
      <p class="descText"><%= Data.description %></p>

      <div class="topInfoRow">
        <div class="priceBox">
          <p class="smallLabel">Monthly Rent</p>
          <p class="priceText">&#8377; <%= Data.price.toLocaleString("en-In") %><span>/month</span></p>
        </div>

        <div class="ownerBox">
          <p class="smallLabel">Owner</p>
          <p class="ownerText"><%= Data.user?.username || Data.user?.name || "Unknown Owner" %></p>
        </div>
      </div>

      <div class="infoGrid">
        <div class="infoItem">
          <p class="infoHeading">Location</p>
          <p class="infoText"><%= Data.location %></p>
        </div>

        <div class="infoItem">
          <p class="infoHeading">State</p>
          <p class="infoText"><%= Data.state %></p>
        </div>

        <div class="infoItem">
          <p class="infoHeading">Room Type</p>
          <p class="infoText"><%= Data.roomType %></p>
        </div>

        <div class="infoItem">
          <p class="infoHeading">Preferred Tenant</p>
          <p class="infoText"><%= Data.preferredTenant %></p>
        </div>

        <div class="infoItem">
          <p class="infoHeading">Contact</p>
          <p class="infoText"><%= Data.contact.phone %></p>
        </div>

        <div class="infoItem">
          <p class="infoHeading">Reviews</p>
          <p class="infoText"><%= Data.reviews.length %> ratings shared</p>
        </div>
      </div>

      <% if (currentUser && Data.user && currentUser._id.equals(Data.user._id)) { %>
        <div class="buttonRow">
          <a href="/listings/<%= Data._id %>/edit" class="commonBtn editBtn">Edit Listing</a>
          <form method="post" action="/listings/<%= Data._id %>?_method=DELETE" class="deleteForm">
            <button class="commonBtn deleteBtn">Delete Listing</button>
          </form>
        </div>
      <% } %>
    </div>
  </section>

  <section class="bottomSection">
    <section class="mapSection whiteBox">
      <div class="titleRow">
        <h2 class="sectionTitle">Location Map</h2>
        <p class="sectionNote">Quick area view</p>
      </div>
      <div id="map" class="mapBox"
        data-id="<%= Data._id %>"
        data-lat="<%= Data.mapCoordinates ? Data.mapCoordinates.coordinates[1] : '' %>"
        data-lon="<%= Data.mapCoordinates ? Data.mapCoordinates.coordinates[0] : '' %>"
        data-location="<%= Data.location || '' %>"
        data-state="<%= Data.state || '' %>">
        <p>Map loading...</p>
      </div>
    </section>

    <section class="reviewFormSection whiteBox">
      <div class="titleRow">
        <h2 class="sectionTitle">Add Your Rating</h2>
        <p class="sectionNote">Share your experience</p>
      </div>

      <div class="formBox">
        <h3 class="formTitle">Share Your Experience</h3>
        <form action="/listings/<%= Data._id %>/reviews" method="POST" class="reviewForm" novalidate>
          <fieldset class="starability-growRotate ratingBox">
            <legend><strong>Rating:</strong></legend>
            <input type="radio" id="rate1" name="review[rating]" value="1"><label for="rate1" title="Terrible">1 star</label>
            <input type="radio" id="rate2" name="review[rating]" value="2"><label for="rate2" title="Not good">2 stars</label>
            <input type="radio" id="rate3" name="review[rating]" value="3" checked><label for="rate3" title="Average">3 stars</label>
            <input type="radio" id="rate4" name="review[rating]" value="4"><label for="rate4" title="Very good">4 stars</label>
            <input type="radio" id="rate5" name="review[rating]" value="5"><label for="rate5" title="Amazing">5 stars</label>
          </fieldset>

          <div class="inputGroup">
            <label for="comment" class="textLabel">Comment</label>
            <textarea class="textArea" name="review[comment]" id="comment" rows="3" placeholder="Write your thoughts..." required></textarea>
          </div>
          <button class="commonBtn submitBtn">Submit Review</button>
        </form>
      </div>
    </section>
  </section>

  <section class="allReviewsSection whiteBox">
    <div class="titleRow">
      <h2 class="sectionTitle">Reviews & Ratings</h2>
      <p class="sectionNote"><%= Data.reviews.length %> total</p>
    </div>

    <div class="reviewsGrid">
      <% if (Data.reviews.length === 0) { %>
        <p class="noReviews">Be the first to leave a review!</p>
      <% } %>

      <% for (let review of Data.reviews) { %>
        <div class="reviewItem">
          <div class="reviewTop">
            <h4 class="userName"><%= review.owner.username || review.owner.name || "Unknown User" %></h4>
            <div class="reviewStars">
              <p class="starability-result" data-rating="<%= review.rating %>"></p>
            </div>
          </div>
          <p class="reviewText"><%= review.comment %></p>

          <% if (currentUser && currentUser._id.equals(review.owner._id)) { %>
            <form method="POST" action="/listings/<%= Data._id %>/reviews/<%= review._id %>?_method=DELETE" class="deleteReviewForm">
              <button class="commonBtn smallDeleteBtn">Delete</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>
</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="/js/detailListingMap.js"></script>

