<% layout('layouts/boilerplate') -%>
<link rel="stylesheet" href="/CSS/edit.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<section class="editPage">
  <div class="editShell">
    <section class="editSection">
      <div class="sectionIntro">
        <p class="sectionTag">Single page edit form</p>
        <h2 class="sectionTitle">Edit your room details</h2>
        <p class="sectionText">
          Update the listing carefully. You can change the room information, upload a new image, and move the map pin if the location needs correction.
        </p>
      </div>

      <form method="POST" action="/listings/<%= Data._id %>?_method=PUT" class="editForm" enctype="multipart/form-data">
        <div class="formFlow">
          <div class="flowSection">
            <div class="sectionHeader">
              <h3 class="flowTitle">Basic details</h3>
              <p class="flowText">Update the title, description, image, and monthly price.</p>
            </div>

            <div class="fieldGrid">
              <div class="fieldGroup fieldGroupWide">
                <label class="fieldLabel" for="title">Listing title</label>
                <input class="fieldInput" type="text" id="title" name="place[title]" value="<%= Data.title %>" required>
              </div>

              <div class="fieldGroup fieldGroupWide">
                <label class="fieldLabel" for="description">Description</label>
                <textarea class="fieldTextarea" id="description" name="place[description]" rows="4" required><%= Data.description %></textarea>
              </div>

              <div class="fieldGroup">
                <label class="fieldLabel" for="image">Replace image</label>
                <input class="fieldInput fieldInputFile" type="file" id="image" name="place[image]">
              </div>

              <div class="fieldGroup">
                <label class="fieldLabel" for="price">Monthly price</label>
                <input class="fieldInput" type="number" id="price" name="place[price]" value="<%= Data.price %>" min="0" required>
              </div>
            </div>
          </div>

          <div class="flowSection">
            <div class="sectionHeader">
              <h3 class="flowTitle">Room preferences</h3>
              <p class="flowText">Update room type, preferred tenant, availability, and contact number.</p>
            </div>

            <div class="fieldGrid">
              <div class="fieldGroup">
                <label class="fieldLabel" for="roomType">Room type</label>
                <select class="fieldSelect" id="roomType" name="place[roomType]" required>
                  <option value="">Select room type</option>
                  <option value="Single" <%= Data.roomType === "Single" ? "selected" : "" %>>Single</option>
                  <option value="Double" <%= Data.roomType === "Double" ? "selected" : "" %>>Double</option>
                  <option value="Shared" <%= Data.roomType === "Shared" ? "selected" : "" %>>Shared</option>
                </select>
              </div>

              <div class="fieldGroup">
                <label class="fieldLabel" for="preferredTenant">Preferred tenant</label>
                <select class="fieldSelect" id="preferredTenant" name="place[preferredTenant]" required>
                  <option value="">Select tenant</option>
                  <option value="Boys" <%= Data.preferredTenant === "Boys" ? "selected" : "" %>>Boys</option>
                  <option value="Girls" <%= Data.preferredTenant === "Girls" ? "selected" : "" %>>Girls</option>
                  <option value="Any" <%= Data.preferredTenant === "Any" ? "selected" : "" %>>Any</option>
                </select>
              </div>

              <div class="fieldGroup">
                <label class="fieldLabel" for="availabilityStatus">Availability</label>
                <select class="fieldSelect" id="availabilityStatus" name="place[availabilityStatus]">
                  <option value="Available" <%= Data.availabilityStatus === "Available" ? "selected" : "" %>>Available</option>
                  <option value="Booked" <%= Data.availabilityStatus === "Booked" ? "selected" : "" %>>Booked</option>
                </select>
              </div>

              <div class="fieldGroup">
                <label class="fieldLabel" for="contactPhone">Contact number</label>
                <input
                  class="fieldInput"
                  type="text"
                  id="contactPhone"
                  name="place[contact]"
                  value="<%= Data.contact ? Data.contact.phone : '' %>"
                  required
                >
              </div>
            </div>
          </div>

          <div class="flowSection">
            <div class="sectionHeader">
              <h3 class="flowTitle">Location details</h3>
              <p class="flowText">Update the address, use your current location, or drag the marker to the exact point.</p>
            </div>

            <div class="fieldGrid">
              <div class="fieldGroup fieldGroupWide">
                <label class="fieldLabel" for="locationField">Location</label>
                <input class="fieldInput" type="text" id="locationField" name="place[location]" value="<%= Data.location %>" required>
              </div>

              <div class="fieldGroup">
                <label class="fieldLabel" for="stateField">State</label>
                <input class="fieldInput" type="text" id="stateField" name="place[state]" value="<%= Data.state %>" required>
              </div>
            </div>

            <input type="hidden" id="latField" name="place[lat]" value="<%= Data.mapCoordinates ? Data.mapCoordinates.coordinates[1] : '' %>">
            <input type="hidden" id="lonField" name="place[lon]" value="<%= Data.mapCoordinates ? Data.mapCoordinates.coordinates[0] : '' %>">

            <div class="mapToolbar">
              <button class="locationButton" type="button" id="currentLocationBtn">Use My Current Location</button>
              <p class="mapHint">Click anywhere on the map or drag the marker to update the location.</p>
            </div>

            <div class="mapFrame">
              <div id="map" class="mapCanvas"
                data-id="<%= Data._id %>"
                data-lat="<%= Data.mapCoordinates ? Data.mapCoordinates.coordinates[1] : '' %>"
                data-lon="<%= Data.mapCoordinates ? Data.mapCoordinates.coordinates[0] : '' %>">
              </div>
            </div>
          </div>
        </div>

        <div class="submitRow">
          <button class="submitButton" type="submit">Update Listing</button>
        </div>
      </form>
    </section>
  </div>
</section>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<script src="/js/editMap.js"></script>
























