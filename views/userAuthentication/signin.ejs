<% layout('layouts/boilerplate') -%>
<link rel="stylesheet" href="/CSS/auth.css">

<section class="authPage">
  <div class="authCard">
    <p class="authTag">Welcome back</p>
    <h1 class="authTitle">Login Now</h1>
    <p class="authText">Sign in to manage your listings and explore student stays.</p>

    <form class="authForm" method="POST" action="/signin">
      <label class="authLabel" for="username">Username</label>
      <input class="authInput" type="text" id="username" name="username" placeholder="Enter your username" required>

      <label class="authLabel" for="password">Password</label>
      <input class="authInput" type="password" id="password" name="password" placeholder="Enter your password" required>

      <button class="authButton" type="submit">Sign In</button>
    </form>

    <p class="authSwitch">
      Don't have an account? <a href="/signup">Sign up</a>
    </p>

    <div class="authDivider">
      <span>or</span>
    </div>

    <div class="authSocialRow">
      <a class="authGoogleLink" href="/auth/google" aria-label="Continue with Google">
        <i class="fa-brands fa-google"></i>
      </a>
    </div>
  </div>
</section>
